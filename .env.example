# Optional AI: core matching works without credentials.
ENABLE_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Total upstream attempts, persistent across restarts; failures also count.
AI_MAX_CALLS=100
# Optional: production mounts a persistent volume at /app/state.
# AI_USAGE_DB=/app/state/ai_usage.sqlite3
