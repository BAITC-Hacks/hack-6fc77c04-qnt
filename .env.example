# Optional AI: core matching works without credentials.
ENABLE_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Total upstream attempts, persistent across restarts; failures also count.
AI_MAX_CALLS=100
# Optional: choose a persistent writable path for the call counter.
